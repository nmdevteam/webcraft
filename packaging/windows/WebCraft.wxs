<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="WebCraft"
    Manufacturer="NM Developers"
    Version="$(var.ProductVersion)"
    UpgradeCode="{B6BD78D6-EB7B-4F88-A4B8-116719B11982}"
    Scope="perMachine"
    InstallerVersion="500">
    <SummaryInformation Description="WebCraft local website builder" Manufacturer="NM Developers" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of WebCraft is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WebCraft">
        <Directory Id="LicenseFolder" Name="licenses" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="WebCraft">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut
            Id="StartWebCraftShortcut"
            Name="WebCraft"
            Description="Start the local WebCraft website builder"
            Target="[INSTALLFOLDER]Start WebCraft.cmd"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKLM"
            Key="Software\NM Developers\WebCraft"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="WebCraftFeature" Title="WebCraft" Level="1">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PayloadFiles">
      <Component Id="ApplicationPayload" Directory="INSTALLFOLDER" Guid="{13B76331-94C5-41A9-AFAE-F1AB10FC4815}">
        <File Id="RuntimeArchive" Source="$(var.PayloadDir)\WebCraft-runtime.zip" KeyPath="yes" />
        <File Id="StartCommand" Source="$(var.PayloadDir)\Start WebCraft.cmd" />
        <File Id="PowerShellLauncher" Source="$(var.PayloadDir)\Start-WebCraft.ps1" />
        <File Id="UserGuide" Source="$(var.PayloadDir)\README.txt" />
        <File Id="ThirdPartyNotices" Source="$(var.PayloadDir)\THIRD-PARTY-NOTICES.txt" />
      </Component>
      <Component Id="LicensePayload" Directory="LicenseFolder" Guid="{F7E958A9-DE79-4F11-9D0B-4A4E43A1A0F2}">
        <File Id="WebCraftLicense" Source="$(var.PayloadDir)\licenses\WebCraft-LICENSE.txt" KeyPath="yes" />
        <File Id="NodeLicense" Source="$(var.PayloadDir)\licenses\Node-LICENSE.txt" />
        <File Id="PostgreSqlLicense" Source="$(var.PayloadDir)\licenses\PostgreSQL-server_license.txt" />
        <File Id="PostgreSqlToolsLicenses" Source="$(var.PayloadDir)\licenses\PostgreSQL-commandlinetools_3rd_party_licenses.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
