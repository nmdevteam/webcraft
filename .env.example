# Local PostgreSQL. `docker compose up -d db` creates this database.
DATABASE_URL=postgres://webcraft:webcraft@127.0.0.1:5432/webcraft
POSTGRES_DB=webcraft
POSTGRES_USER=webcraft
POSTGRES_PASSWORD=replace-with-a-long-random-password

# `pnpm run setup` generates these values in the local .env file. Do not commit .env.
PAYLOAD_SECRET=replace-with-at-least-32-random-bytes
WEBCRAFT_SECRET=replace-with-at-least-32-random-bytes
CMS_URL=http://127.0.0.1:3000
BUILDER_ORIGIN=http://127.0.0.1:5173
